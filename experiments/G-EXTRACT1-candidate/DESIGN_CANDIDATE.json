      "exact unknown sentinel",
      "canonical supported-field values",
      "reason no factual value is supported"
    ],
    "review_steps": [
      "author creates fixture, derivation, gold, rationale, fingerprint and reserve mapping",
      "Reviewer A solves without seeing proposed gold",
      "Reviewer B audits arithmetic, calendar semantics, bindings, family assignment and exact-value compliance",
      "operator-approved adjudicator resolves preserved disagreements before provider contact"
    ],
    "fixtures_gold_reserves_equivalence_and_adjudication_freeze_together": true,
    "post_contact_gold_defect_invalidates_affected_run": true,
