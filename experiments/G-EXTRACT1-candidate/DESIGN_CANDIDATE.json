  "result_state_machine": {
    "contract_id": "g-extract1.result-state-machine.v1",
    "exactly_one_primary_verdict": true,
    "first_match_precedence": [
      {
        "precedence": 1,
        "verdict": "INVALID",
        "predicate": "protected artifact, gold, blindness, scorer, configuration, contamination, schedule or denominator-integrity contract is violated after execution begins, or a result cannot be trusted"
