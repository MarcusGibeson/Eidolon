  "cell_state_machine": {
    "phase_b_selector": "sorted exact set of A_QUALIFIED_FOR_B cell IDs",
    "operator_selection_allowed": false,
    "transitions": [
      [
        "A_SCHEDULED",
        "protected preflight fails before contact",
        "A_BLOCKED"
      ],
      [
        "A_SCHEDULED",
        "complete denominator and all A gates pass",
        "A_QUALIFIED_FOR_B"
      ],
      [
        "A_SCHEDULED",
        "complete denominator and any A gate fails",
        "A_FAILED"
      ],
      [
        "A_SCHEDULED",
        "missing or untrustworthy denominator",
        "A_INCOMPLETE"
      ],
      [
        "A_QUALIFIED_FOR_B",
        "machine-built conditional schedule contains exact cell",
        "B_SCHEDULED"
      ],
      [
        "A_FAILED",
        "always",
        "B_NOT_ELIGIBLE"
      ],
      [
        "B_SCHEDULED",
        "complete denominator and all B gates pass",
        "FINALLY_QUALIFIED"
      ],
      [
        "B_SCHEDULED",
        "complete denominator and any B gate fails",
        "B_FAILED_VALIDATION"
