# Eidolon source-only safety: keep runtime/private records out of git.
__pycache__/
*.py[cod]
*.log
*.zip
.venv/
venv/
.env

# The whole runtime data root. The live store is %LOCALAPPDATA%/Eidolon/data and
# this tree is local residue: 1.9 GB across 182k files, including 113 MB of
# private conversation transcripts that conversation_sessions.py states must
# never be packaged as source. The per-path rules below predate this and are kept
# so the intent stays legible.
data/

# Runtime/private data generated by local use.
data/tasks.json
data/approvals/
data/chat_actions/
data/self_development_cycles/
data/releases/
data/release_package/
data/action_log.json
data/memories.json
data/thoughts.log
data/dashboard_chat/
data/code_patches/
data/patches/
data/watch/
data/notifications/
data/goals/
data/memory_candidates/
data/autonomy/
data/self_maintenance/
sandbox/retired_evidence_quarantine/
data/release_candidates/
data/candidate_packages/
data/release_handoffs/
data/cognition/
